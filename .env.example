# Copy this file to .env.local for local development.
# Build values live in EAS Environment Variables, one set per eas.json
# profile environment; `eas env:pull` writes them into .env.local.
# https://docs.expo.dev/eas/environment-variables/

EXPO_PUBLIC_API_URL=https://api.guitar0.net

# PostHog — the web app's project token (phc_…). Leave unset for local
# development: analytics and error tracking are disabled in every dev build.
# EXPO_PUBLIC_POSTHOG_KEY=
