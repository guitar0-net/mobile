{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],

  "minimumReleaseAge": "3 days",

  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": "0 days"
  },

  "schedule": ["before 6am on Saturday"],

  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "rebaseWhen": "behind-base-branch",
  "major": {
    "labels": ["dependencies", "breaking-change"]
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Saturday"],
    "labels": ["dependencies", "npm"],
    "commitMessageAction": "refresh transitive dependencies",
    "postUpdateOptions": ["npmDedupe"]
  },

  "packageRules": [
    {
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/**",
        "babel-preset-expo",
        "eslint-config-expo",
        "jest-expo"
      ],
      "groupName": "expo-sdk",
      "minimumReleaseAge": "1 day",
      "schedule": ["before 6am"]
    },
    {
      "description": "Versions pinned by the Expo SDK; updated via `npx expo install --fix` during SDK upgrades",
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-test-renderer",
        "@types/react",
        "react-native",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-web",
        "react-native-worklets",
        "@react-native-async-storage/async-storage",
        "lottie-react-native"
      ],
      "enabled": false
    },
    {
      "description": "npm rejects lock-file-only updates of overridden packages with EOVERRIDE; lockFileMaintenance refreshes them instead",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "labels": ["dependencies", "ci"]
    }
  ]
}
