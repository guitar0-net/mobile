{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:types": "openapi-typescript https://api.guitar0.net/api/v1/schema/ --output src/lib/network/api.types.ts",
    "db:generate": "drizzle-kit generate",
    "type:check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@tanstack/react-query": "^5.100.14",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.1",
    "expo-iap": "~5.0.1",
    "expo-image": "~57.0.1",
    "expo-keep-awake": "~57.0.0",
    "expo-linking": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-precision-metronome": "^1.2.0",
    "expo-router": "~57.0.9",
    "expo-screen-orientation": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "nativewind": "^4.2.6",
    "pitchy": "^4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-audio-api": "0.13.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.0.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "jest-expo": "~57.0.3",
    "lint-staged": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": ">=14.0.0",
    "esbuild": ">=0.25.0",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "private": true
}
