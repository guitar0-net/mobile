{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:types": "openapi-typescript https://api.guitar0.net/api/v1/schema/ --output src/lib/network/api.types.ts",
    "db:generate": "drizzle-kit generate",
    "type:check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/react-query": "^5.100.14",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.27",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.18",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.11",
    "expo-keep-awake": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-precision-metronome": "^1.2.0",
    "expo-router": "~55.0.16",
    "expo-screen-orientation": "~55.0.17",
    "expo-splash-screen": "~55.0.22",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.19",
    "expo-video": "~55.0.18",
    "nativewind": "^4.2.6",
    "pitchy": "^4.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-audio-api": "^0.12.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.0.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~55.0.8",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "jest-expo": "~55.0.19",
    "lint-staged": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-test-renderer": "^19.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": ">=14.0.0",
    "esbuild": ">=0.25.0"
  },
  "private": true
}
